# --------------------------------------------------
# Project paths
# --------------------------------------------------

# User ID used by Airflow containers.
# Linux users can replace this value with the result of: id -u
AIRFLOW_UID=1000

# Project directory mounted inside the Airflow containers
AIRFLOW_PROJ_DIR=.

# Environment file used by Docker Compose
ENV_FILE_PATH=.env


# --------------------------------------------------
# Climate PostgreSQL database
# --------------------------------------------------

POSTGRES_DB=climate_db
POSTGRES_USER=climate_user
POSTGRES_PASSWORD=replace_with_a_secure_password

# Docker Compose service name.
# Do not use localhost for communication between containers.
POSTGRES_HOST=climate-postgres
POSTGRES_PORT=5432


# --------------------------------------------------
# Airflow security
# --------------------------------------------------

# Generate a valid Fernet key before starting the project
FERNET_KEY=replace_with_a_generated_fernet_key

# Secret used to sign Airflow API authentication tokens
AIRFLOW__API_AUTH__JWT_SECRET=replace_with_a_random_secret

# JWT token issuer
AIRFLOW__API_AUTH__JWT_ISSUER=airflow


# --------------------------------------------------
# Airflow administrator
# --------------------------------------------------

_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=replace_with_a_secure_password


# --------------------------------------------------
# Optional Airflow configuration
# --------------------------------------------------

# Dependencies are already installed through Dockerfile.airflow.
# Keep empty unless performing a temporary test.
_PIP_ADDITIONAL_REQUIREMENTS=